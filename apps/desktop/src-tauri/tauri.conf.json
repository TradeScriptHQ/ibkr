{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeScript Terminal",
  "version": "0.1.0",
  "identifier": "dev.tradescript.ibkr-terminal",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/terminal-node"],
    "resources": ["runtime/"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "A local IBKR workstation powered by TradeScript",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["tradescript-terminal"] }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
