# TradeScript localhost package access and runtime authorization.
# Copy to .env and fill from the Developer Console one-time handoff.
TRADESCRIPT_NPM_TOKEN=
TRADESCRIPT_PACKAGE_NAME=@tradescript/pro-developer-console-free
TRADESCRIPT_CREDENTIAL_ID=
TRADESCRIPT_CREDENTIAL_SECRET=
TRADESCRIPT_CREDENTIAL_EXCHANGE_URL=
TRADESCRIPT_SDK_VERSION=0.1.34
TRADESCRIPT_CUSTOMER_BUILD_FINGERPRINT=
TRADESCRIPT_REQUESTED_ORIGIN=http://localhost:3000

# Local application endpoints.
UI_HOST=127.0.0.1
UI_PORT=3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001

# Local state directory. Defaults to <repo>/.local/state when unset. The desktop
# app does not read this file; it uses the OS per-application data directory.
# TERMINAL_DATA_DIR=

# IBKR TWS paper session. Client 0 is intentional: this workstation is the
# primary API client and may bind eligible manual TWS orders after disclosure.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=0
IBKR_MASTER_CLIENT_ID=0
IBKR_BIND_MANUAL_TWS_ORDERS=false
IBKR_EXECUTION_ENVIRONMENT=paper
IBKR_ALLOWED_ACCOUNT_IDS=

# Independent agent trading remains subject to the host risk policy.
AGENT_TRADING_ENABLED=false
AGENT_AUTONOMY_MODE=paper-auto
AGENT_MAX_ORDER_QUANTITY=
AGENT_MAX_ORDER_NOTIONAL=
AGENT_MAX_POSITION_QUANTITY=
AGENT_MAX_POSITION_NOTIONAL=
AGENT_MAX_GROSS_EXPOSURE=
AGENT_MAX_DAILY_LOSS=
AGENT_MAX_ORDERS_PER_MINUTE=
AGENT_MAX_ESTIMATED_SLIPPAGE_BPS=
AGENT_MAX_MARKET_DATA_AGE_MS=
AGENT_MAX_LEVERAGE=
AGENT_MAX_UNPROTECTED_POSITION_QUANTITY=
